    "@vueuse/components": "^14.4.0",
    "@vueuse/core": "^14.4.0",
    "html-to-image": "^1.11.13",
    "js-base64": "^3.8.0",
    "jspdf": "^4.2.1",
    "normalize.css": "^8.0.1",
    "nprogress": "^0.2.0",
    "pinia": "^2.1.7",
    "tone": "^15.1.22",
    "v-wave": "^3.1.1",
    "vue": "3.5.11",
    "vue-draggable-plus": "^0.6.1",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/nprogress": "^0.2.3",
    "@vitejs/plugin-vue": "^5.0.4",
