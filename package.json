{
  "name": "fret-logic",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:proxy": "node ./scripts/dev-webdav-proxy.mjs",
    "check": "vue-tsc",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "generate-code": "node ./scripts/generate-all-code.mjs",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "code:check": "vue-tsc --noEmit && pnpm build",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "vue-tsc --noEmit",
    "build:budget": "node ./scripts/check-bundle.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "bench": "node scripts/bench.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "generate-icon": "node ./scripts/compress-images.mjs"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@floating-ui/vue": "^2.0.1",
    "@lucide/vue": "^1.17.0",
    "@vueuse/components": "^14.4.0",
    "@vueuse/core": "^14.4.0",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "normalize.css": "^8.0.1",
    "nprogress": "^0.2.0",
    "pinia": "^2.1.7",
    "tone": "^15.1.22",
    "v-wave": "^3.1.1",
    "vue": "3.5.11",
    "vue-draggable-plus": "^0.6.1",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/nprogress": "^0.2.3",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.8.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-vue": "^10.10.0",
    "fake-indexeddb": "^6.2.5",
    "gh-pages": "^6.3.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "prettier": "^3.4.2",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass-embedded": "^1.103.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.4.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^5.2.0",
    "vite-node": "^6.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "3.2.4",
    "vue-tsc": "^2.0.6"
  }
}
