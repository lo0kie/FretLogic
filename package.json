{
  "name": "fret-logic",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:proxy": "node ./scripts/dev-webdav-proxy.mjs",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit --incremental",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/.eslintcache --cache-strategy content",
    "lint:fix": "eslint . --fix --cache --cache-location node_modules/.cache/eslint/.eslintcache --cache-strategy content && prettier --write --cache --cache-location node_modules/.cache/prettier/.prettiercache .",
    "format": "node ./scripts/prettier-format.mjs",
    "format:check": "prettier --check --cache --cache-location node_modules/.cache/prettier/.prettiercache .",
    "build": "vite build",
    "build:analyze": "vite build --mode analyze",
    "build:budget": "node ./scripts/check-bundle.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "node scripts/bench.mjs",
    "gen:code": "node ./scripts/generate-all-code.mjs",
    "gen:icon": "node ./scripts/compress-images.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@floating-ui/vue": "^2.0.1",
    "@vueuse/core": "^14.4.0",
    "nprogress": "^0.2.0",
    "pinia": "^2.1.7",
    "pinyin-pro": "^3.29.3",
    "tone": "^15.1.22",
    "v-wave": "^3.1.1",
    "vue": "3.5.11",
    "vue-draggable-plus": "^0.6.1",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@iconify-json/lucide": "^1.2.128",
    "@iconify-json/simple-icons": "^1.2.94",
    "@prettier/plugin-oxc": "^0.2.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/nprogress": "^0.2.3",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-vue": "^10.10.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "prettier": "^3.4.2",
    "prettier-plugin-css-order": "^2.2.0",
    "prettier-plugin-ember-template-tag": "^2.1.8",
    "prettier-plugin-merge": "^0.10.1",
    "prettier-plugin-organize-attributes": "^1.0.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass-embedded": "^1.103.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.4.2",
    "typescript-eslint": "^8.67.0",
    "unplugin-icons": "^23.0.1",
    "vite": "^5.2.0",
    "vite-node": "^6.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "3.2.4",
    "vue-tsc": "^2.0.6"
  }
}
