# 部署与环境地址配置（Vite 仅注入 VITE_ 前缀变量）
# Worker 托管名称（Workers Builds 部署目标，与 wrangler.jsonc 的 name 保持一致）
VITE_WORKER_NAME=fret-logic-web
# 线上云端同步服务地址
VITE_SYNC_SERVER_URL=https://fret-logic-service.server-lookie.workers.dev/
# 内置 WebDAV CORS 代理地址
VITE_WEBDAV_PROXY_URL=https://fret-logic-proxy.server-lookie.workers.dev/
